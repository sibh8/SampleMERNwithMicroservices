{
  "comment": "Import with: aws cloudwatch put-dashboard --dashboard-name mern-stack --dashboard-body file://monitoring/cloudwatch-dashboard.json  (replace ClusterName if different)",
  "widgets": [
    {
      "type": "metric",
      "x": 0, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Pod CPU Utilization by Service",
        "region": "ap-south-1",
        "stat": "Average",
        "period": 60,
        "view": "timeSeries",
        "metrics": [
          [ "ContainerInsights", "pod_cpu_utilization", "ClusterName", "mern-eks-cluster", "Namespace", "mern", "Service", "mern-frontend" ],
          [ "...", "mern-hello-service" ],
          [ "...", "mern-profile-service" ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Pod Memory Utilization by Service",
        "region": "ap-south-1",
        "stat": "Average",
        "period": 60,
        "view": "timeSeries",
        "metrics": [
          [ "ContainerInsights", "pod_memory_utilization", "ClusterName", "mern-eks-cluster", "Namespace", "mern", "Service", "mern-frontend" ],
          [ "...", "mern-hello-service" ],
          [ "...", "mern-profile-service" ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "Running Pods by Service",
        "region": "ap-south-1",
        "stat": "Average",
        "period": 60,
        "view": "timeSeries",
        "metrics": [
          [ "ContainerInsights", "service_number_of_running_pods", "ClusterName", "mern-eks-cluster", "Namespace", "mern", "Service", "mern-frontend" ],
          [ "...", "mern-hello-service" ],
          [ "...", "mern-profile-service" ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "Node CPU & Memory",
        "region": "ap-south-1",
        "stat": "Average",
        "period": 60,
        "view": "timeSeries",
        "metrics": [
          [ "ContainerInsights", "node_cpu_utilization", "ClusterName", "mern-eks-cluster" ],
          [ "ContainerInsights", "node_memory_utilization", "ClusterName", "mern-eks-cluster" ]
        ]
      }
    }
  ]
}
